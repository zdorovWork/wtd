{
  "name": "@wtd/server",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node --env-file=.env --watch --import tsx src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "check": "tsc --noEmit",
    "migrate": "node --env-file-if-exists=.env --import tsx src/migrate.ts",
    "seed": "node --env-file-if-exists=.env --import tsx src/seed.ts",
    "test": "node --env-file-if-exists=.env ./node_modules/jest/bin/jest.js && node --env-file-if-exists=.env ./node_modules/jest/bin/jest.js --config ./test/jest-e2e.json"
  },
  "dependencies": {
    "@nestjs/common": "11.2.8",
    "@nestjs/core": "11.2.8",
    "@nestjs/platform-express": "11.2.8",
    "express": "^5.3.0",
    "node-pg-migrate": "^9.0.0",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/testing": "11.2.8",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.14",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^6.0.3",
    "jest": "^29.7.0",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.6",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
